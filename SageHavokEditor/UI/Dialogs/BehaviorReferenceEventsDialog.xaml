<Window x:Class="SageHavokEditor.UI.Dialogs.BehaviorReferenceEventsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Events across a behavior reference" Height="620" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeadlineText" Margin="0,0,0,8"
                   FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <!-- filter bar -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="FilterBox" TextChanged="FilterBox_TextChanged"
                     Padding="5,3" VerticalContentAlignment="Center"
                     ToolTip="Filter by event name"/>

            <CheckBox Grid.Column="1" x:Name="UnsharedOnlyCheck" Content="Only events that can't cross"
                      VerticalAlignment="Center" Margin="10,0,0,0"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"
                      ToolTip="Events one side uses and the other has no entry for. Normal for a child graph's internal events — vanilla 0_master has hundreds — so read this as a list to check, not a list of faults."/>

            <Button Grid.Column="2" Content="📋 Copy report" Click="BtnCopy_Click"
                    Margin="10,0,0,0" Padding="8,3"
                    ToolTip="Copy the whole comparison to the clipboard"/>
        </Grid>

        <ListView Grid.Row="2" x:Name="EventsList"
                  Background="{DynamicResource BgMidBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  BorderBrush="{DynamicResource BorderBrush}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Event" Width="320"
                                    DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="This file" Width="130"
                                    DisplayMemberBinding="{Binding Here}"/>
                    <GridViewColumn x:Name="ThereColumn" Width="130"
                                    DisplayMemberBinding="{Binding There}"/>
                    <GridViewColumn Header="" Width="260"
                                    DisplayMemberBinding="{Binding Note}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Click="BtnClose_Click" Padding="14,5"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,0,15,0"/>
        </DockPanel>
    </Grid>
</Window>
