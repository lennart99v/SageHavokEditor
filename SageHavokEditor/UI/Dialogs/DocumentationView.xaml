<UserControl x:Class="SageHavokEditor.UI.Dialogs.DocumentationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Widened with the text: at 150% the section names clipped. -->
            <ColumnDefinition x:Name="NavColumn" Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left nav panel -->
        <Border Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="NavPanel" Margin="0,8,0,8"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Reading controls. The Guide's text sizes were fixed, which on a
                 high-resolution monitor reads very small with no way to change
                 it; and the text could be copied but not with its formatting,
                 so there was no way to take it out of the app either. -->
            <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Text size" VerticalAlignment="Center" FontSize="11"
                               Margin="0,0,6,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button x:Name="BtnGuideZoomOut" Content="−" Width="24" Padding="0"
                            FontSize="13" ToolTip="Smaller text (Ctrl+−, or Ctrl+scroll)"
                            Click="BtnGuideZoomOut_Click"/>
                    <TextBlock x:Name="GuideZoomLabel" Text="100%" VerticalAlignment="Center"
                               FontSize="11" Width="42" TextAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button x:Name="BtnGuideZoomIn" Content="+" Width="24" Padding="0"
                            FontSize="13" ToolTip="Larger text (Ctrl++, or Ctrl+scroll)"
                            Click="BtnGuideZoomIn_Click"/>
                    <Button x:Name="BtnGuideZoomReset" Content="Reset" Padding="8,2"
                            FontSize="11" Margin="6,0,0,0"
                            ToolTip="Back to 100% (Ctrl+0)"
                            Click="BtnGuideZoomReset_Click"/>
                    <Button x:Name="BtnGuideExport" Content="⭳ Save as Markdown"
                            Padding="8,2" FontSize="11" Margin="12,0,0,0"
                            ToolTip="Write this whole Guide out as a .md file, formatting intact — for reading outside the app."
                            Click="BtnGuideExport_Click"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" x:Name="ContentScroller"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="ContentScroller_PreviewMouseWheel"
                          Padding="32,24,32,40">
                <StackPanel x:Name="ContentPanel" MaxWidth="860"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
