<Window x:Class="SageHavokEditor.UI.Dialogs.EventCrossReferenceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Cross-Reference" Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- filter bar -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="FilterBox" TextChanged="FilterBox_TextChanged"
                     Padding="5,3" VerticalContentAlignment="Center"
                     ToolTip="Filter events by name or id"/>

            <CheckBox Grid.Column="1" x:Name="UnusedOnlyCheck" Content="Unreferenced only"
                      VerticalAlignment="Center" Margin="10,0,0,0"
                      Checked="UnusedOnlyCheck_Changed" Unchecked="UnusedOnlyCheck_Changed"
                      ToolTip="Events nothing in THIS file references. Not the same as unused — annotation events (HitFrame, SoundPlay.*, spell-fire) are emitted from annotation tracks inside the animation .hkx files, and cross-behaviour events are matched by name in another file. Treat these as leads, not as safe to delete."/>

            <Button Grid.Column="2" Content="📋 Copy report" Click="BtnCopy_Click"
                    Margin="10,0,0,0" Padding="8,3"
                    ToolTip="Copy the full cross-reference of the selected event to the clipboard"/>
        </Grid>

        <!-- events | usages -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Events" FontWeight="SemiBold"
                               Margin="6,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ListBox x:Name="EventsList" SelectionChanged="EventsList_SelectionChanged"
                             BorderThickness="0" FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Counts}" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Id}" FontSize="10"
                                               VerticalAlignment="Center" Margin="6,0,2,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"/>

            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="UsageHeader" FontWeight="SemiBold"
                               Margin="6,4" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Select an event"/>
                    <ListBox x:Name="UsagesList" BorderThickness="0" FontSize="12"
                             MouseDoubleClick="UsagesList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#2A2A3A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UsageType}" Value="Transition">
                                                            <Setter Property="Background" Value="#1A3A5C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UsageType}" Value="Wildcard">
                                                            <Setter Property="Background" Value="#3A1A5C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UsageType}" Value="Trigger">
                                                            <Setter Property="Background" Value="#1A3A1A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UsageType}" Value="Property">
                                                            <Setter Property="Background" Value="#3A2A00"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UsageType}" Value="Notify">
                                                            <Setter Property="Background" Value="#5C2A1A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UsageType}" Value="Interval">
                                                            <Setter Property="Background" Value="#1A4A4A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding UsageType}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Border>
                                        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value=""/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Direction}" Value="Listens">
                                                            <Setter Property="Text" Value="◀ listens"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Direction}" Value="Sends">
                                                            <Setter Property="Text" Value="▶ sends"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding SubText}" FontSize="10" Margin="0,1,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
            <Button Content="Close" Click="BtnClose_Click" HorizontalAlignment="Right"
                    Padding="14,4" IsCancel="True"/>
        </DockPanel>
    </Grid>
</Window>
