<Window x:Class="SageHavokEditor.UI.Dialogs.ValidationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SageHavokEditor"
        Title="File Integrity Validation"
        Height="550" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDarkBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Headline + summary badges -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
        <TextBlock x:Name="HeadlineText" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="13" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal">
            <!-- Errors badge -->
            <Border CornerRadius="4" Padding="10,4" Margin="0,0,8,0"
                    Background="{DynamicResource BadgePurpleBrush}"
                    BorderBrush="{DynamicResource BadgePurpleTextBrush}"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource BadgePurpleBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BadgePurpleTextBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorCount}" Value="0">
                                <Setter Property="Background" Value="{DynamicResource BadgeGreenBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BadgeGreenTextBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✕ " FontWeight="Bold"
                               Foreground="{DynamicResource BadgePurpleTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource BadgePurpleTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorCount}" Value="0">
                                        <Setter Property="Foreground" Value="{DynamicResource BadgeGreenTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="ErrorCountText" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource BadgePurpleTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorCount}" Value="0">
                                        <Setter Property="Foreground" Value="{DynamicResource BadgeGreenTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text=" Errors">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource BadgePurpleTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorCount}" Value="0">
                                        <Setter Property="Foreground" Value="{DynamicResource BadgeGreenTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Warnings badge. Goes green at zero the way the errors badge does:
                 an amber "0 Warnings" beside a green "0 Errors" reads as a
                 problem you haven't found yet. -->
            <Border CornerRadius="4" Padding="10,4" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource BadgeYellowBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BadgeYellowTextBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WarningCount}" Value="0">
                                <Setter Property="Background" Value="{DynamicResource BadgeGreenBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BadgeGreenTextBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style x:Key="WarningBadgeText" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource BadgeYellowTextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WarningCount}" Value="0">
                                    <Setter Property="Foreground" Value="{DynamicResource BadgeGreenTextBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>
                    <TextBlock Text="⚠ " FontWeight="Bold" Style="{StaticResource WarningBadgeText}"/>
                    <TextBlock x:Name="WarningCountText" FontWeight="SemiBold"
                               Style="{StaticResource WarningBadgeText}"/>
                    <TextBlock Text=" Warnings" Style="{StaticResource WarningBadgeText}"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </StackPanel>

        <!-- Filter -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="FilterAll"      Content="All"           IsChecked="True"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Margin="0,0,10,0" Checked="Filter_Changed"/>
            <RadioButton x:Name="FilterErrors"   Content="Errors only"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Margin="0,0,10,0" Checked="Filter_Changed"/>
            <RadioButton x:Name="FilterWarnings" Content="Warnings only"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Checked="Filter_Changed"/>
        </StackPanel>

        <!-- Issue list -->
        <!-- No horizontal scroll: the description is the point of a row, and the
             doctor's are long enough that a row scrolled off to the right reads
             as a blank. Rows wrap to the dialog's width instead. -->
        <ListBox x:Name="IssueList" Grid.Row="2"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="{DynamicResource BgMidBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 SelectionChanged="IssueList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Severity badge -->
                        <Border Grid.Column="0" CornerRadius="3" Padding="6,2"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource BadgeYellowBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BadgePurpleBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BadgeYellowTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource BadgePurpleTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- Object name -->
                        <TextBlock Grid.Column="1" Text="{Binding ObjectName}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="5,0"/>

                        <!-- Class -->
                        <TextBlock Grid.Column="2" Text="{Binding ObjectClass}"
                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="5,0"/>

                        <!-- Description, and under it the likely cause when the
                             check has one to offer -->
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="5,0">
                            <TextBlock Text="{Binding Description}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Cause}" FontSize="10" FontStyle="Italic"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCause}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="SelectHint"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="11" VerticalAlignment="Center" Margin="0,0,15,0"
                       Text="Click an issue to navigate to the object"/>
            <!-- Pre-save mode swaps Close for a decision; see ValidationDialog.cs -->
            <Button x:Name="BtnSaveAnyway" Content="Save anyway" Padding="14,5"
                    Margin="0,0,8,0" Visibility="Collapsed" Click="BtnSaveAnyway_Click"/>
            <Button x:Name="BtnCancelSave" Content="Cancel save" Padding="14,5"
                    Visibility="Collapsed" IsCancel="True" Click="BtnCancelSave_Click"/>
            <Button x:Name="BtnCloseReport" Content="Close" Click="BtnClose_Click" Padding="14,5"/>
        </StackPanel>
    </Grid>
</Window>
