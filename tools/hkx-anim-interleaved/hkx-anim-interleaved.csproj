<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>hkx-anim-interleaved</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The editor's own animation parser, not a copy: this checks the code the
         clip preview actually runs. -->
    <Compile Include="..\..\SageHavokEditor\Core\Animation\HKTransform.cs" />
    <Compile Include="..\..\SageHavokEditor\Core\Animation\SkeletonParser.cs" />
    <Compile Include="..\..\SageHavokEditor\Core\Animation\HavokSplineDecoder.cs" />
    <Compile Include="..\..\SageHavokEditor\Core\Animation\HavokAnimationParser.cs" />
  </ItemGroup>

</Project>
