<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>hkx-duplicate-state</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile the editor's own model and duplicator, not a copy, so this
         exercises the same code the graph's "Duplicate state…" runs. -->
    <Compile Include="..\..\SageHavokEditor\Models\HavokModels.cs" />
    <Compile Include="..\..\SageHavokEditor\Core\HavokManager.cs" />
    <Compile Include="..\..\SageHavokEditor\Core\Services\HavokTypeCatalog.cs" />
    <Compile Include="..\..\SageHavokEditor\Core\Services\ModifierCatalog.cs" />
    <Compile Include="..\..\SageHavokEditor\Core\Services\StateDuplicator.cs" />
    <ProjectReference Include="..\..\libs\HKX2Library\HKX2\HKX2.csproj" />
  </ItemGroup>

</Project>
