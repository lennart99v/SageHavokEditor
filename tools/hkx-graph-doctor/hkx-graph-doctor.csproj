    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>hkx-graph-doctor</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile the editor's own model and validation, not a copy, so this
