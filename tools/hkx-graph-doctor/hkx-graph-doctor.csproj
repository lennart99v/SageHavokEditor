    <Compile Include="..\..\SageHavokEditor\Core\HavokManager.cs" />
    <Compile Include="..\..\SageHavokEditor\Core\Services\HavokTypeCatalog.cs" />
    <Compile Include="..\..\SageHavokEditor\Core\Services\ModifierCatalog.cs" />
    <Compile Include="..\..\SageHavokEditor\Core\Validation\HkRefWalk.cs" />
    <Compile Include="..\..\SageHavokEditor\Core\Validation\ValidationIssue.cs" />
    <Compile Include="..\..\SageHavokEditor\Core\Validation\HavokValidator.cs" />
    <Compile Include="..\..\SageHavokEditor\Core\Validation\GraphDoctor.cs" />
    <ProjectReference Include="..\..\libs\HKX2Library\HKX2\HKX2.csproj" />
  </ItemGroup>

</Project>
